BD_NOMBRE=luanfra
BD_USUARIO=luanfra
BD_PASSWORD=
ENTORNO=desarrollo
# JSON de hashes SHA-256 a nombres de administradores del piloto.
# Generar clave con secrets.token_urlsafe(32); guardar solo su hash aquí.
ACCESO_CLAVES_JSON={}

# Lectores industriales: opcionales, requieren SDK/cuenta del proveedor.
# Ruta absoluta a MTKConverter instalado con licencias de desarrollo y ejecución.
CADEX_MTK_CONVERTER=
CADEX_MTK_VERSION=
# Werk24 usa su configuración oficial de credenciales; no pegar claves en Git.
# Activar solo tras configurar el tratamiento externo de planos.
WERK24_HABILITADO=false
